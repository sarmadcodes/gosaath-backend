{
  "name": "gosaath-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/app/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/app/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "contract:check": "tsx scripts/contract.ts check",
    "contract:sync": "tsx scripts/contract.ts sync",
    "check:shutdown": "node tests/manual/shutdown-check.mjs",
    "verify": "npm run contract:check && npm run typecheck && npm test && npm run build",
    "db:indexes": "tsx scripts/ensure-indexes.ts",
    "db:seed": "tsx scripts/seed.ts",
    "db:generate": "tsx scripts/generate-instances.ts",
    "db:seed:demo": "tsx scripts/seed-demo.ts"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.1",
    "@fastify/helmet": "^12.0.1",
    "@fastify/rate-limit": "^10.2.1",
    "@fastify/under-pressure": "^9.0.1",
    "@node-rs/argon2": "^2.2.1",
    "dotenv": "^16.4.7",
    "fastify": "^5.2.0",
    "jose": "^6.2.12",
    "mongoose": "^8.9.5",
    "pino": "^9.6.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.6",
    "mongodb-memory-server": "^11.3.0",
    "pino-pretty": "^13.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^3.2.7"
  }
}
