# Copy to .env and fill in. Never commit .env.
NODE_ENV=development
PORT=4000
HOST=0.0.0.0

# Every recurring schedule is interpreted in this zone, never the host's.
TZ=Asia/Karachi

# Local: mongodb://127.0.0.1:27017
# Atlas: mongodb+srv://USER:PASSWORD@cluster.mongodb.net
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=gosaath
MONGODB_POOL_SIZE=20

LOG_LEVEL=info
LOG_PRETTY=true

# Exact origins only, comma separated. Never "*" for an authenticated API.
# Required outside development.
CORS_ORIGINS=http://localhost:5173

BODY_LIMIT_BYTES=262144
REQUEST_TIMEOUT_MS=20000

# Minimum 32 characters. Required outside development.
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# --- Email ---------------------------------------------------------------
# "console" logs the message instead of sending — fine for development, and
# rejected outside it. "resend" sends real mail.
EMAIL_PROVIDER=console
RESEND_API_KEY=
# Must be a verified sender on your Resend domain.
# onboarding@resend.dev works for testing but only delivers to your own address.
EMAIL_FROM=GoSaath <onboarding@resend.dev>
EMAIL_REPLY_TO=
EMAIL_TIMEOUT_MS=8000

# --- Uploads -----------------------------------------------------------------
# local writes to disk and is development only: it survives neither a second
# server nor a redeploy. Outside development the app refuses to boot unless
# this is s3.
UPLOADS_PROVIDER=local
UPLOADS_DIR=var/uploads
# This server's own address, used to sign local upload links.
PUBLIC_URL=http://localhost:4000

# S3-compatible object storage. Cloudflare R2 is the cheaper fit: no egress
# charges, and photos are read far more often than written.
# R2 endpoint: https://<account-id>.r2.cloudflarestorage.com
S3_BUCKET=
S3_REGION=auto
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# --- Media (profile photos) -------------------------------------------------
# Where profile PHOTOS live. Documents follow UPLOADS_PROVIDER and never come
# here — see services/storage/cloudinary.provider.ts for why.
# cloudinary | s3 | local   (local is development only)
MEDIA_PROVIDER=local
# From the Cloudinary dashboard. The secret is server-side only and must never
# reach the mobile app: uploads are signed here and sent device -> Cloudinary.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
