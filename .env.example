# Copy to .env and fill in. Never commit .env.
NODE_ENV=development
PORT=4000
HOST=0.0.0.0

# Every recurring schedule is interpreted in this zone, never the host's.
TZ=Asia/Karachi

# Local: mongodb://127.0.0.1:27017
# Atlas: mongodb+srv://USER:PASSWORD@cluster.mongodb.net
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=gosaath
MONGODB_POOL_SIZE=20

LOG_LEVEL=info
LOG_PRETTY=true

# Exact origins only, comma separated. Never "*" for an authenticated API.
# Required outside development.
CORS_ORIGINS=http://localhost:5173

BODY_LIMIT_BYTES=262144
REQUEST_TIMEOUT_MS=20000

# Minimum 32 characters. Required outside development.
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# --- Email ---------------------------------------------------------------
# "console" logs the message instead of sending — fine for development, and
# rejected outside it. "resend" sends real mail.
EMAIL_PROVIDER=console
RESEND_API_KEY=
# Must be a verified sender on your Resend domain.
# onboarding@resend.dev works for testing but only delivers to your own address.
EMAIL_FROM=GoSaath <onboarding@resend.dev>
EMAIL_REPLY_TO=
EMAIL_TIMEOUT_MS=8000
